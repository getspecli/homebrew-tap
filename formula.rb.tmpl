class Specli < Formula
  desc "Browser viewer/editor for spec-driven design artifacts"
  homepage "https://spec.li"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/getspecli/specli/releases/download/@TAG@/specli_@TAG@_darwin_arm64.tar.gz"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "https://github.com/getspecli/specli/releases/download/@TAG@/specli_@TAG@_darwin_amd64.tar.gz"
      sha256 "@SHA_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/getspecli/specli/releases/download/@TAG@/specli_@TAG@_linux_arm64.tar.gz"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/getspecli/specli/releases/download/@TAG@/specli_@TAG@_linux_amd64.tar.gz"
      sha256 "@SHA_LINUX_AMD64@"
    end
  end

  def install
    bin.install Dir["specli_*/specli"]
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/specli --version")
  end
end
